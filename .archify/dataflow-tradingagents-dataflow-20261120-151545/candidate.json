  "cards": [
    {
      "dot": "cyan",
      "title": "共享 AgentState",
      "items": [
        "初始标的语境在全图可见，Trader／风控／组合经理另用持仓语境。",
        "Trader 还直接读取市场报告，风控读各分析报告，组合经理直接读投资计划与提案。",
        "各 analyst 子图保有私有工具消息，汇合返回各自报告字段。"
      ]
    },
    {
      "dot": "emerald",
      "title": "日期约束",
      "items": [
        "分析工具锁定到分析日，历史财报按披露日期过滤，无披露日则不给历史数值。",
        "结算使用分析日之后首个有效收盘作为基准点，等完整持有窗口届满；历史经验只读截止日前已知的结算结果。"
      ]
    },
    {
      "dot": "violet",
      "title": "落盘与返回",
      "items": [
        "组合经理写 final_trade_decision 和 final_rating。运行层落盘状态及待结算决策，Python 返回状态和评级，CLI 或 API 按需另存报告。",
        "回测逐格复用同一决策过程，结算后仅用独立账本的结果统计。"
      ]
    }
  ]
