  "cards": [
    {
      "dot": "cyan",
      "title": "Agent 和模型职责",
      "items": [
        "市场、情绪、新闻、基本面按所选分支并行，记忆结算也参加汇合。",
        "多空辩论后由研究经理定研究计划，Trader 给提案，激进／保守／中性辩论后由组合经理产出最终评级。",
        "两个经理用 deep，分析、辩论、Trader 与记忆反思用 quick。"
      ]
    },
    {
      "dot": "emerald",
      "title": "哪些路径绕过通用路由",
      "items": [
        "情绪分析直接调用 Stocktwits／Reddit，可选 TypeSafe Jev 过滤帖子。标的身份、市场快照与记忆结算收盘价直接用 Yahoo 适配器。",
        "通用路由接入 Yahoo、Alpha Vantage、SEC EDGAR、FRED、Polymarket。"
      ]
    },
    {
      "dot": "violet",
      "title": "运行边界",
      "items": [
        "本地 Python 进程可由 CLI、脚本或 Docker 启动。外部模型和数据由客户端调用。",
        "组合输入来自调用者 JSON。持仓只进入决策提示与恢复签名，组合经理产出建议。"
      ]
    },
    {
      "dot": "amber",
      "title": "三种持久化用途",
      "items": [
        "SQLite 恢复未完成的图，成功后清理相应线程。",
        "状态 JSON 为单次结果；报告目录按需生成。完成后的决策写入账本，后续补结算，回测汇总读取其独立账本。"
      ]
    }
